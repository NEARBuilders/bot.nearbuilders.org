{
  "name": "near-builders-x-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless X nomination listener and NEAR Builders onboarding handoff",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xdevplatform/xdk": "0.6.6",
    "dotenv": "17.2.1",
    "pino": "10.3.1",
    "rotating-file-stream": "3.2.9"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
