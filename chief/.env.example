# Token of Chief, the review bot (a separate bot from the onboarding bot; create it with @BotFather).
TELEGRAM_BOT_TOKEN=your_review_bot_token_here
# API key of a dedicated NON-admin nearbuilders.org account, granted {"reviews":["read","write"]}.
NEARBUILDERS_API_KEY=your_api_key_here
# Private admin group chat ID. The bot must be a member, ideally an admin with only Pin + Delete.
ADMIN_CHAT_ID=-1001234567890

# Optional. Defaults to https://nearbuilders.org. All API URLs below derive from it.
# NEARBUILDERS_SITE_URL=https://nearbuilders.org
# Optional. Defaults to info. Use debug only for local troubleshooting.
# LOG_LEVEL=info
# Optional. Days before an item counts as overdue. Defaults to 7.
# DIGEST_STALE_AFTER_DAYS=7
# Optional, digest job only. healthchecks.io-style URL pinged after each run (/fail on failure).
# DIGEST_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid
# Optional endpoint overrides, for local testing.
# NEAR_REVIEW_DIGEST_URL=https://nearbuilders.org/api/reviews/digest
# NEAR_REVIEW_DECISION_URL=https://nearbuilders.org/api/reviews/telegram-decision
# NEAR_TELEGRAM_LINK_URL=https://nearbuilders.org/api/reviews/telegram-links
